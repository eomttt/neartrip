# REST 키는 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
KAKAO_REST_API_KEY=
# 웹 SDK용 공개 키. 로컬 주소와 배포 도메인을 카카오 허용 도메인에 등록하세요.
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# 기존 1Password VITE_KAKAO_JAVASCRIPT_KEY도 호환합니다.
DEMO_MODE=false

# 공공데이터포털 국문 관광정보·반려동물 동반여행 서비스의 Decoding 인증키. 서버 전용 Secret.
TOUR_API_SERVICE_KEY=

# 서울 열린데이터광장 일반 인증키. 서버 전용 Secret.
SEOUL_OPEN_API_KEY=

# 운영 빌드에서 애드센스를 불러옵니다. false로 설정하고 다시 배포하면 광고를 끕니다.
# 개발 서버와 Vercel Preview에서는 광고를 불러오지 않습니다.
ADSENSE_ENABLED=true
