# 지도 표시용 공개 키. Maps JavaScript API만 허용하고 웹사이트 리퍼러를 제한하세요.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 장소 검색용 서버 전용 키. Places API (New)만 허용하세요.
GOOGLE_PLACES_API_KEY=
# 한국 도보·대중교통·차량 경로 조회용 서버 전용 키.
KAKAO_REST_API_KEY=
DEMO_MODE=false

# 공공데이터포털 국문 관광정보·반려동물 동반여행 서비스의 Decoding 인증키. 서버 전용 Secret.
TOUR_API_SERVICE_KEY=

# 서울 열린데이터광장 일반 인증키. 서버 전용 Secret.
SEOUL_OPEN_API_KEY=

# 운영 빌드에서 애드센스를 불러옵니다. false로 설정하고 다시 배포하면 광고를 끕니다.
# 개발 서버와 Vercel Preview에서는 광고를 불러오지 않습니다.
ADSENSE_ENABLED=true
